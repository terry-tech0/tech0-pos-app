# Copy to .env and fill in. .env is gitignored (NFR-SEC-03).
# See docs/design/POS-Lv2-設計仕様書.md section 2.4 for the full table.
# ASCII only: pip / python read this with the system codepage on Japanese Windows.

# --- Database (SSL required for Azure MySQL) ---
# Azure : mysql+pymysql://USER:PASSWORD@HOST.mysql.database.azure.com/pos_terry?ssl_disabled=false
# Local : mysql+pymysql://root:PASSWORD@127.0.0.1:3306/pos_terry
DATABASE_URL=

# --- JWT (design 8.2). 32 bytes or more of random data. Never commit the real value ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
JWT_ISSUER=tech0-pos-app

# --- local / production. production disables Swagger and /openapi.json (design 8.7) ---
APP_ENV=local

# --- CORS (design 8.5). Empty means nobody is allowed ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Login attempt limit (design 8.1 S-4) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60
